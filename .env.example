# Mercado Pago (credenciales de prueba) — ver README para cómo conseguirlas.
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# Clave para las rutas /api/admin (enviar en el header x-admin-key).
ADMIN_API_KEY="cambia-esto"

# Firebase (cliente) — ver la consola de Firebase > Configuración del proyecto.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (servidor) — generar una service account key en Firebase Console
# y copiar sus campos aquí. NUNCA subas el JSON de la service account al repo.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
