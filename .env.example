# Mercado Pago (credenciales de prueba) — ver README para cómo conseguirlas.
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# Stripe (llaves de prueba) — ver README para cómo conseguirlas.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Clave para las rutas /api/admin (enviar en el header x-admin-key).
ADMIN_API_KEY="cambia-esto"

# Firebase (cliente) — ver la consola de Firebase > Configuración del proyecto.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (servidor) — generar una service account key en Firebase Console.
# NUNCA subas el archivo .json de la service account al repo.
#
# Forma recomendada: convierte el .json COMPLETO a base64 (ver README, es un
# solo comando) y pégalo aquí en una sola línea — evita todos los problemas
# de saltos de línea al copiar la llave privada a mano.
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Alternativa (si prefieres los campos por separado en vez de base64):
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
