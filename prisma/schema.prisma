generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A department of the store. Some categories exist in the schema before
// they have products — e.g. "Celulares" (phone sales stay in-store only
// for now) and "Impermeabilizantes" (catalog pending) — so the storefront
// can show them as "Próximamente" instead of needing a migration later.
model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  comingSoon Boolean   @default(false)
  products   Product[]
  createdAt  DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  spec        String // short one-line spec shown on the product card
  priceCents  Int // store money as integer centavos (MXN) to avoid float rounding
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One checkout attempt. Created as "pending" the moment we redirect the
// customer to Mercado Pago, then flipped to "paid"/"failed" by the webhook —
// never by the success-page redirect, since an OXXO ticket is paid days
// later at a physical store, not at checkout time.
model Order {
  id             String      @id @default(cuid())
  status         String      @default("pending") // pending | paid | failed | canceled
  mpPreferenceId String?     @unique // filled in right after creation, once Mercado Pago responds
  mpPaymentId    String?
  paymentMethod  String? // e.g. "credit_card" / "debit_card" / "ticket" (OXXO), from Mercado Pago's payment_type_id
  customerEmail  String?
  totalCents     Int
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// Snapshot of a product at the moment of purchase — kept even if the
// product's price or name changes later, so past orders stay accurate.
model OrderItem {
  id         String @id @default(cuid())
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  productId  String
  name       String
  priceCents Int
  quantity   Int
}
